<file path="src\ui\dom.js">
export function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, character => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
    })[character]);
}

if (typeof window !== 'undefined') {
    window.escapeHtml = escapeHtml;
}

</file>

<file path="src\ui\formatters.js">
const SUBSCRIPT_DIGITS = Object.freeze({
    '0': '₀', '1': '₁', '2': '₂', '3': '₃', '4': '₄',
    '5': '₅', '6': '₆', '7': '₇', '8': '₈', '9': '₉'
});

export function fmtNum(value, decimals = 4) {
    if (value === null || value === undefined || Number.isNaN(value)) return '0';
    if (Math.abs(value) < 1e-9) return '0';
    const factor = 10 ** decimals;
    return (Math.round(value * factor) / factor).toString();
}

export function subDigit(value) {
    return String(value).split('').map(character => SUBSCRIPT_DIGITS[character] || character).join('');
}

export function formatLinearExpression(coeffs, count) {
    const terms = [];
    for (let index = 0; index < count; index += 1) {
        const coefficient = coeffs[index] || 0;
        const subscript = subDigit(index + 1);
        if (Math.abs(coefficient) < 1e-9 && terms.length > 0) continue;
        const absolute = Math.abs(coefficient);
        const sign = coefficient < 0 ? '-' : (terms.length === 0 ? '' : '+');
        const coefficientText = (absolute === 1 && coefficient !== 0) ? '' : fmtNum(absolute);
        if (coefficient === 0 && terms.length === 0 && index < count - 1) continue;
        terms.push(`${sign} ${coefficientText}x${subscript}`.trim());
    }
    return terms.length > 0 ? terms.join(' ') : '0';
}

window.fmtNum = fmtNum;
window.subDigit = subDigit;
window.formatLinearExpression = formatLinearExpression;

</file>

<file path="src\ui\toast.js">
const COLOR_MAP = Object.freeze({
    info: 'bg-slate-900 border-cyan-500/50 text-cyan-200',
    success: 'bg-slate-900 border-emerald-500/50 text-emerald-200',
    warn: 'bg-slate-900 border-amber-500/50 text-amber-200',
    error: 'bg-slate-900 border-rose-500/50 text-rose-200'
});

const ICON_MAP = Object.freeze({
    info: 'fa-circle-info text-cyan-400',
    success: 'fa-circle-check text-emerald-400',
    warn: 'fa-triangle-exclamation text-amber-400',
    error: 'fa-circle-xmark text-rose-400'
});

export function showToast(message, type = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border shadow-xl backdrop-blur-md text-xs sm:text-sm transition-all duration-300 ${COLOR_MAP[type] || COLOR_MAP.info}`;
    toast.innerHTML = `
        <i class="fa-solid ${ICON_MAP[type] || ICON_MAP.info} text-base"></i>
        <span class="flex-1 font-medium">${message}</span>
    `;
    container.appendChild(toast);

    setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(8px)';
        setTimeout(() => toast.remove(), 300);
    }, 3200);
}

// Keep legacy inline handlers working while controllers are migrated.
window.showToast = showToast;

</file>

<file path="tests\domain\lp-model.test.js">
import test from 'node:test';
import assert from 'node:assert/strict';
import { createLpModel, validateLpModel } from '../../src/domain/lp-model.js';

test('creates and validates an LP model', () => {
    const model = createLpModel({
        type: 'max',
        numVars: 2,
        varNames: ['x1', 'x2'],
        varTypes: ['cont', 'cont'],
        objCoeffs: [2, 3],
        constraints: [{ coeffs: [1, 1], op: '<=', rhs: 10 }]
    });
    assert.equal(validateLpModel(model).valid, true);
});

