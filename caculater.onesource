<file path="src\domain\geometry.js">
export function clipPolygonByHalfPlane(polygon, a, b, c) {
    if (!polygon.length) return [];
    const inside = point => a * point.x + b * point.y <= c + 1e-9;
    const intersection = (start, end) => {
        const startValue = a * start.x + b * start.y - c;
        const endValue = a * end.x + b * end.y - c;
        const ratio = startValue / (startValue - endValue);
        return {
            x: start.x + ratio * (end.x - start.x),
            y: start.y + ratio * (end.y - start.y)
        };
    };

    const result = [];
    for (let index = 0; index < polygon.length; index += 1) {
        const current = polygon[index];
        const previous = polygon[(index + polygon.length - 1) % polygon.length];
        const currentInside = inside(current);
        const previousInside = inside(previous);
        if (currentInside !== previousInside) result.push(intersection(previous, current));
        if (currentInside) result.push(current);
    }
    return result;
}

</file>

<file path="src\domain\integer-solver.js">
import { solveContinuousLP } from './lp-solver.js';
const MAX_NODES = 250;

export function solveFullLPModel(modelInput, maxNodes = MAX_NODES) {
            // 深拷貝模型
            const baseModel = JSON.parse(JSON.stringify(modelInput));
            const n = baseModel.numVars;

            // 若有 0-1 二元變數，自動補上 x_i <= 1 的內部邊界限制
            for (let i = 0; i < n; i++) {
                if (baseModel.varTypes[i] === 'bin') {
                    let coeffs = new Array(n).fill(0);
                    coeffs[i] = 1;
                    baseModel.constraints.push({
                        name: `_bin_bound_${i}`,
                        coeffs,
                        op: '<=',
                        rhs: 1,
                        isExtraBound: true
                    });
                }
            }

            const hasIntOrBin = baseModel.varTypes.some(t => t === 'int' || t === 'bin');
            if (!hasIntOrBin) {
                return solveContinuousLP(baseModel);
            }

            // 若包含整數或 0-1 變數，先求 LP Relaxation，再進行 Branch & Bound
            const rootSol = solveContinuousLP(baseModel);
            if (rootSol.status !== 'optimal') {
                return rootSol;
            }

            const isMax = baseModel.type === 'max';
            let bestZ = isMax ? -Infinity : Infinity;
            let bestSol = null;
            let totalIter = 0;

            let queue = [baseModel];
            let nodesExplored = 0;
            while (queue.length > 0 && nodesExplored < maxNodes) {
                const currModel = queue.pop();
                nodesExplored++;

                const sol = solveContinuousLP(currModel);
                totalIter += sol.iterations || 1;

                if (sol.status !== 'optimal') continue;

                // Bound 剪枝
                if (isMax && sol.z <= bestZ + 1e-7) continue;
                if (!isMax && sol.z >= bestZ - 1e-7) continue;

                // 檢查所有整數/二元變數是否已為整數
                let fracVarIdx = -1;
                for (let i = 0; i < n; i++) {
                    if (currModel.varTypes[i] === 'int' || currModel.varTypes[i] === 'bin') {
                        const val = sol.x[i];
                        if (Math.abs(val - Math.round(val)) > 1e-5) {
                            fracVarIdx = i;
                            break;
                        }
                    }
                }

                if (fracVarIdx === -1) {
                    // 找到可行整數解
                    if ((isMax && sol.z > bestZ) || (!isMax && sol.z < bestZ)) {
                        bestZ = sol.z;
                        bestSol = sol;
                    }
                } else {
                    // 分支 (Branching): x_i <= floor(val) 與 x_i >= ceil(val)
                    const val = sol.x[fracVarIdx];
                    const floorVal = Math.floor(val);
                    const ceilVal = Math.ceil(val);

                    let leftModel = JSON.parse(JSON.stringify(currModel));
                    let cLeft = new Array(n).fill(0);
                    cLeft[fracVarIdx] = 1;
                    leftModel.constraints.push({
                        name: `_bb_le_${fracVarIdx}`,
                        coeffs: cLeft,
                        op: '<=',
                        rhs: floorVal,
                        isExtraBound: true
                    });

                    let rightModel = JSON.parse(JSON.stringify(currModel));
                    let cRight = new Array(n).fill(0);
                    cRight[fracVarIdx] = 1;
                    rightModel.constraints.push({
                        name: `_bb_ge_${fracVarIdx}`,
                        coeffs: cRight,
                        op: '>=',
                        rhs: ceilVal,
                        isExtraBound: true
                    });

                    queue.push(leftModel);
                    queue.push(rightModel);
                }
            }

            const truncated = queue.length > 0;
            if (!bestSol) {
                return {
                    status: truncated ? 'limit' : 'infeasible',
                    iterations: totalIter,
                    truncated
                };
            }

            // 以原始 LP Relaxation 的對偶影子價格補充說明，並更新整數最佳解之 LHS 與 Slack
            bestSol.x = bestSol.x.map((v, i) => (baseModel.varTypes[i] === 'int' || baseModel.varTypes[i] === 'bin') ? Math.round(v) : v);
            bestSol.iterations = totalIter;
            bestSol.isIntegerOptimal = !truncated;
            if (truncated) {
                bestSol.status = 'limit';
                bestSol.truncated = true;
            }
            return bestSol;
        }
</file>

<file path="src\domain\lp-model.js">
export const VARIABLE_TYPES = Object.freeze(['cont', 'free', 'int', 'bin']);
export const OPERATORS = Object.freeze(['<=', '>=', '=']);

export function createLpModel(input = {}) {
    const model = {
        type: input.type === 'min' ? 'min' : 'max',
        unit: input.unit || '',
        numVars: Number(input.numVars) || 0,
        varNames: [...(input.varNames || [])],
        varTypes: [...(input.varTypes || [])],
        objCoeffs: [...(input.objCoeffs || [])],
        constraints: (input.constraints || []).map(constraint => ({
            name: constraint.name || '',
            coeffs: [...(constraint.coeffs || [])],
            op: OPERATORS.includes(constraint.op) ? constraint.op : '<=',
            rhs: Number(constraint.rhs) || 0
        }))
    };

    return model;
}

export function validateLpModel(model) {
    const errors = [];
    if (!model || !Number.isInteger(model.numVars) || model.numVars < 1) {
        errors.push('numVars must be a positive integer');
    }
    if (model && model.varNames.length !== model.numVars) {
        errors.push('varNames length must match numVars');
    }
    if (model && model.objCoeffs.length !== model.numVars) {
        errors.push('objCoeffs length must match numVars');
    }
    if (model && model.varTypes.some(type => !VARIABLE_TYPES.includes(type))) {
        errors.push('varTypes contains an unsupported variable type');
    }
    if (model && model.constraints.some(({ coeffs, op }) => coeffs.length !== model.numVars || !OPERATORS.includes(op))) {
        errors.push('constraints contain invalid coefficients or operator');
    }
    return { valid: errors.length === 0, errors };
}

export function cloneLpModel(model) {
    return createLpModel(JSON.parse(JSON.stringify(model)));
}

</file>

<file path="src\domain\lp-solver.js">
export function solveContinuousLP(model) {
            const EPS = 1e-8;
            const isMax = model.type === 'max';
            const nOrig = model.numVars;

            // 1. 處理自由變數 (Free Variables): x_i = x_i^+ - x_i^-
            // 每個原始變數對應到標準型變數索引
            let varMap = [];
            let stdObj = [];
            for (let i = 0; i < nOrig; i++) {
                const c = isMax ? (model.objCoeffs[i] || 0) : -(model.objCoeffs[i] || 0);
                if (model.varTypes[i] === 'free') {
                    const posIdx = stdObj.length;
                    stdObj.push(c);
                    const negIdx = stdObj.length;
                    stdObj.push(-c);
                    varMap.push({ type: 'free', posIdx, negIdx });
                } else {
                    const idx = stdObj.length;
                    stdObj.push(c);
                    varMap.push({ type: 'nonneg', idx });
                }
            }

            const nDecisionCols = stdObj.length;

            // 2. 整理所有限制式 (包含原始限制式 + 二元變數 x_i <= 1 或 B&B 附加邊界限制)
            let rawConstraints = [];
            model.constraints.forEach((c, idx) => {
                let rowCoeffs = new Array(nDecisionCols).fill(0);
                for (let i = 0; i < nOrig; i++) {
                    const val = c.coeffs[i] || 0;
                    if (varMap[i].type === 'free') {
                        rowCoeffs[varMap[i].posIdx] = val;
                        rowCoeffs[varMap[i].negIdx] = -val;
                    } else {
                        rowCoeffs[varMap[i].idx] = val;
                    }
                }
                rawConstraints.push({
                    origIndex: idx,
                    isExtraBound: Boolean(c.isExtraBound),
                    coeffs: rowCoeffs,
                    op: c.op,
                    rhs: c.rhs
                });
            });

            const m = rawConstraints.length;

            // 3. 將每條限制式正規化為 RHS >= 0，並記錄是否翻轉符號 (影響對偶影子價格正負號)
            let normConstraints = rawConstraints.map(c => {
                let coeffs = [...c.coeffs];
                let op = c.op;
                let rhs = c.rhs;
                let flipped = false;
                if (rhs < -EPS) {
                    rhs = -rhs;
                    coeffs = coeffs.map(v => -v);
                    if (op === '<=') op = '>=';
                    else if (op === '>=') op = '<=';
                    flipped = true;
                } else if (Math.abs(rhs) <= EPS) {
                    rhs = 0;
                }
                return { ...c, coeffs, op, rhs, flipped };
            });

            // 4. 加入鬆弛變數 (Slack)、剩餘變數 (Surplus) 與人工變數 (Artificial)
            let totalCols = nDecisionCols;
            let slackCols = new Array(m).fill(-1);
            let artificialCols = [];
            let basis = new Array(m).fill(-1);

            normConstraints.forEach((c, r) => {
                if (c.op === '<=') {
                    slackCols[r] = totalCols;
                    basis[r] = totalCols;
                    totalCols++;
                } else if (c.op === '>=') {
                    slackCols[r] = totalCols; // surplus (-1)
                    totalCols++;
                    const artCol = totalCols;
                    artificialCols.push({ row: r, col: artCol });
                    basis[r] = artCol;
                    totalCols++;
                } else if (c.op === '=') {
                    const artCol = totalCols;
                    artificialCols.push({ row: r, col: artCol });
                    basis[r] = artCol;
                    totalCols++;
                }
            });

            // 建立單形表 (Simplex Tableau): m 列限制式 + 2 列目標列 (Row m: Phase 2 目標; Row m+1: Phase 1 目標)
            let tableau = [];
            for (let r = 0; r < m; r++) {
                let row = new Array(totalCols + 1).fill(0);
                const c = normConstraints[r];
                for (let j = 0; j < nDecisionCols; j++) {
                    row[j] = c.coeffs[j];
                }
                if (c.op === '<=') {
                    row[slackCols[r]] = 1;
                } else if (c.op === '>=') {
                    row[slackCols[r]] = -1;
                }
                row[totalCols] = c.rhs;
                tableau.push(row);
            }

            artificialCols.forEach(art => {
                tableau[art.row][art.col] = 1;
            });

            // Row m: Phase 2 Objective Row (初始設定為 -c_j，最大化標準型 z - c^T x = 0)
            let phase2Row = new Array(totalCols + 1).fill(0);
            for (let j = 0; j < nDecisionCols; j++) {
                phase2Row[j] = -stdObj[j];
            }
            tableau.push(phase2Row);

            // Row m+1: Phase 1 Objective Row (最小化 sum a_i <=> 最大化 W = -sum a_i, W + sum a_i = 0)
            let phase1Row = new Array(totalCols + 1).fill(0);
            artificialCols.forEach(art => {
                phase1Row[art.col] = 1;
            });
            tableau.push(phase1Row);

            // 消去人工變數在 Phase 1 目標列之基底係數
            artificialCols.forEach(art => {
                const r = art.row;
                for (let j = 0; j <= totalCols; j++) {
                    tableau[m + 1][j] -= tableau[r][j];
                }
            });

            let iterations = 0;
            const MAX_ITER = 600;

            // 單形法樞軸迭代函式 (Bland's Rule 防循環)
            function runSimplexPhase(objRowIdx, isPhase1) {
                while (iterations < MAX_ITER) {
                    // 尋找進入變數 (Entering Variable): 目標列中係數最負者
                    let pivotCol = -1;
                    let minCoeff = -1e-7;

                    for (let j = 0; j < totalCols; j++) {
                        // Phase 2 時禁止人工變數進入基底
                        if (!isPhase1 && artificialCols.some(a => a.col === j)) continue;
                        const val = tableau[objRowIdx][j];
                        if (val < minCoeff) {
                            minCoeff = val;
                            pivotCol = j;
                        }
                    }

                    // 已達最佳條件
                    if (pivotCol === -1) {
                        return 'optimal';
                    }

                    // 最小比值檢驗 (Minimum Ratio Test) 尋找離開變數 (Leaving Variable)
                    let pivotRow = -1;
                    let minRatio = Infinity;

                    for (let r = 0; r < m; r++) {
                        const a_ij = tableau[r][pivotCol];
                        if (a_ij > 1e-7) {
                            const ratio = tableau[r][totalCols] / a_ij;
                            if (ratio < minRatio - 1e-9 || (Math.abs(ratio - minRatio) <= 1e-9 && basis[r] > basis[pivotRow])) {
                                minRatio = ratio;
                                pivotRow = r;
                            }
                        }
                    }

                    if (pivotRow === -1) {
                        return 'unbounded';
                    }

                    // 執行高斯消去樞軸運算 (Pivot Operation)
                    const pivotVal = tableau[pivotRow][pivotCol];
                    for (let j = 0; j <= totalCols; j++) {
                        tableau[pivotRow][j] /= pivotVal;
                    }

                    for (let r = 0; r <= m + 1; r++) {
                        if (r === pivotRow) continue;
                        const factor = tableau[r][pivotCol];
                        if (Math.abs(factor) > 1e-11) {
                            for (let j = 0; j <= totalCols; j++) {
                                tableau[r][j] -= factor * tableau[pivotRow][j];
                            }
                        }
                    }

                    basis[pivotRow] = pivotCol;
                    iterations++;
                }
                return 'max_iter';
            }

            // 執行第一階段 (Phase 1)
            if (artificialCols.length > 0) {
                const status1 = runSimplexPhase(m + 1, true);
                const wVal = tableau[m + 1][totalCols];
                if (status1 !== 'optimal' || Math.abs(wVal) > 1e-5) {
                    return { status: 'infeasible', iterations };
                }

                // 若人工變數仍在基底且值為0，嘗試將其替換出基底
                for (let r = 0; r < m; r++) {
                    if (artificialCols.some(a => a.col === basis[r])) {
                        for (let j = 0; j < nDecisionCols + m; j++) {
                            if (!artificialCols.some(a => a.col === j) && Math.abs(tableau[r][j]) > 1e-6) {
                                const pivotVal = tableau[r][j];
                                for (let k = 0; k <= totalCols; k++) tableau[r][k] /= pivotVal;
                                for (let rowIdx = 0; rowIdx <= m; rowIdx++) {
                                    if (rowIdx === r) continue;
                                    const factor = tableau[rowIdx][j];
                                    for (let k = 0; k <= totalCols; k++) tableau[rowIdx][k] -= factor * tableau[r][k];
                                }
                                basis[r] = j;
                                break;
                            }
                        }
                    }
                }
            }

            // 執行第二階段 (Phase 2)
            const status2 = runSimplexPhase(m, false);
            if (status2 === 'unbounded') {
                return { status: 'unbounded', iterations };
            }

            // 5. 萃取決策變數最佳解 x*
            let stdVarVals = new Array(totalCols).fill(0);
            for (let r = 0; r < m; r++) {
                stdVarVals[basis[r]] = tableau[r][totalCols];
            }

            let xOpt = new Array(nOrig).fill(0);
            for (let i = 0; i < nOrig; i++) {
                if (varMap[i].type === 'free') {
                    xOpt[i] = stdVarVals[varMap[i].posIdx] - stdVarVals[varMap[i].negIdx];
                } else {
                    xOpt[i] = stdVarVals[varMap[i].idx];
                }
            }

            const maxZ = tableau[m][totalCols];
            const zOpt = isMax ? maxZ : -maxZ;

            // 6. 計算每條原始限制式之 LHS、Slack/Surplus、Binding 狀態與對偶影子價格 (Shadow Price)
            // 原理：在最終單形表第 m 列 (Phase 2 目標列) 中，初始基底欄位 (對應第 r 條正規化限制式之 Slack 或 Artificial 變數)
            // 其係數即為 c_B B^{-1} e_r (最大化問題之對偶變數 y_r)
            let constraintAnalysis = [];
            normConstraints.forEach((nc, r) => {
                if (nc.isExtraBound) return; // 略過分支界限法附加之內部邊界

                const origC = model.constraints[nc.origIndex];
                let lhs = 0;
                for (let i = 0; i < nOrig; i++) {
                    lhs += (origC.coeffs[i] || 0) * xOpt[i];
                }
                const rhs = origC.rhs;
                const diff = Math.abs(rhs - lhs);
                const isBinding = diff <= 1e-5;

                // 取出第 r 條正規化限制式對應之初始單位矩陣欄位 (Identity column)
                let idCol = -1;
                let colSign = 1; // 若初始欄位為 +1，則表內目標列係數為 +c_B B^{-1} e_r
                if (nc.op === '<=') {
                    idCol = slackCols[r];
                    colSign = 1;
                } else {
                    const artObj = artificialCols.find(a => a.row === r);
                    idCol = artObj ? artObj.col : -1;
                    colSign = 1;
                }

                let shadowPrice = 0;
                if (idCol !== -1) {
                    // 對 max Z 而言，dZ_max / d(b_norm) = tableau[m][idCol] * colSign
                    let dZmax_dbnorm = tableau[m][idCol] * colSign;
                    // 若為 min Z，Z_min = -Z_max
                    let dZ_dbnorm = isMax ? dZmax_dbnorm : -dZmax_dbnorm;
                    // 若正規化時因為負 RHS 乘過 -1，則 d(b_norm)/d(b_orig) = -1
                    shadowPrice = nc.flipped ? -dZ_dbnorm : dZ_dbnorm;
                }

                if (Math.abs(shadowPrice) < 1e-8) shadowPrice = 0;

                constraintAnalysis.push({
                    index: nc.origIndex,
                    name: origC.name || `限制式 ${nc.origIndex + 1}`,
                    op: origC.op,
                    coeffs: origC.coeffs,
                    lhs: lhs,
                    rhs: rhs,
                    slack: diff,
                    isBinding: isBinding,
                    shadowPrice: shadowPrice
                });
            });

            return {
                status: 'optimal',
                z: zOpt,
                x: xOpt,
                iterations,
                constraints: constraintAnalysis
            };
        }

        /**
         * 整合求解入口：自動處理連續線性規劃 (LP) 與整數/二元規劃 (MIP Branch & Bound)
         */
</file>

<file path="src\domain\transport-model.js">
import { createLpModel } from './lp-model.js';

export function createTransportModel(state) {
    const sourceCount = state.numSources;
    const destinationCount = state.numDests;
    const numVars = sourceCount * destinationCount;
    const varNames = [];
    const objCoeffs = [];

    for (let source = 0; source < sourceCount; source += 1) {
        for (let destination = 0; destination < destinationCount; destination += 1) {
            varNames.push(`${state.sourceNames[source]}→${state.destNames[destination]}`);
            objCoeffs.push(Number(state.costs[source]?.[destination]) || 0);
        }
    }

    const constraints = [];
    for (let source = 0; source < sourceCount; source += 1) {
        const coeffs = Array(numVars).fill(0);
        for (let destination = 0; destination < destinationCount; destination += 1) {
            coeffs[source * destinationCount + destination] = 1;
        }
        constraints.push({ name: `供給限制 ${state.sourceNames[source]}`, coeffs, op: '<=', rhs: Number(state.supplies[source]) || 0 });
    }

    for (let destination = 0; destination < destinationCount; destination += 1) {
        const coeffs = Array(numVars).fill(0);
        for (let source = 0; source < sourceCount; source += 1) {
            coeffs[source * destinationCount + destination] = 1;
        }
        constraints.push({ name: `需求限制 市場${state.destNames[destination]}`, coeffs, op: '=', rhs: Number(state.demands[destination]) || 0 });
    }

    return createLpModel({ type: 'min', unit: '元 (總運輸成本)', numVars, varNames, varTypes: Array(numVars).fill('cont'), objCoeffs, constraints });
}

export function isBalancedTransport(state) {
    const supply = state.supplies.reduce((total, value) => total + Number(value || 0), 0);
    const demand = state.demands.reduce((total, value) => total + Number(value || 0), 0);
    return Math.abs(supply - demand) < 1e-9;
}

</file>

<file path="src\features\ai-parser\parser-view.js">
import { parseNaturalLanguageToModel } from './parser.js';
export function fillAIPromptSample(sampleId) {
            const box = document.getElementById('ai-nlp-input');
            if (sampleId === 1) {
                box.value = '某工廠生產產品A與產品B。產品A每單位利潤20元，產品B每單位利潤15元。原料限制為 2x1 + 1x2 <= 20，工時限制為 1x1 + 3x2 <= 35，求最大利潤。';
            } else {
                box.value = '最小化採購成本：原料甲每公斤成本 5 元，原料乙每公斤成本 8 元。營養素限制 2x1 + 3x2 >= 18，重量限制 1x1 + 1x2 >= 7。';
            }
        }

export function parseNaturalLanguageToLP() {
            const text = document.getElementById('ai-nlp-input').value.trim();
            if (!text) {
                showToast('請先輸入自然語言問題描述', 'warn');
                return;
            }

            const model = parseNaturalLanguageToModel(text);
            lpState = model;

            const feedback = document.getElementById('ai-parse-feedback');
            feedback.classList.remove('hidden');
            feedback.innerHTML = `
                <div class="text-emerald-400 font-semibold flex items-center gap-1.5">
                    <i class="fa-solid fa-circle-check"></i> AI 語意建模完成！已自動轉換為標準線性規劃模型並完成求解。
                </div>
                <div class="text-slate-300 font-mono">
                    識別類型：${model.type.toUpperCase()} | 目標係數：[${model.objCoeffs.join(', ')}] | 限制式數量：${model.constraints.length} 條
                </div>
            `;

            renderAllGeneralLPInputs();
            solveCurrentLP();
            switchMainTab('general');
            showToast('AI 已完成自然語言解析並載入模型求解！', 'success');
        }

if (typeof window !== 'undefined') {
    Object.assign(window, { fillAIPromptSample, parseNaturalLanguageToLP });
}

</file>

<file path="src\features\ai-parser\parser.js">
export function parseObjectiveType(text) {
    const isMin = /最小|最低|成本|min/i.test(text) && !/最大|最高|max/i.test(text);
    return isMin ? 'min' : 'max';
}

export function parseNaturalLanguageToModel(text) {
    const type = parseObjectiveType(text);
    const constraintPattern = /([+-]?\s*\d*\.?\d*)\s*\*?\s*(?:x_?1|x₁|產品A|原料甲)\s*([+-]\s*\d*\.?\d*)\s*\*?\s*(?:x_?2|x₂|產品B|原料乙)\s*(<=|>=|=|≤|≥)\s*([+-]?\d+\.?\d*)/gi;
    const constraints = [];
    let match;

    while ((match = constraintPattern.exec(text)) !== null) {
        const parseCoefficient = value => {
            const coefficient = value.replace(/\s+/g, '');
            if (coefficient === '' || coefficient === '+') return 1;
            if (coefficient === '-') return -1;
            return Number.parseFloat(coefficient) || 0;
        };
        const operator = match[3] === '≤' ? '<=' : match[3] === '≥' ? '>=' : match[3];
        constraints.push({
            name: `AI解析限制式 ${constraints.length + 1}`,
            coeffs: [parseCoefficient(match[1]), parseCoefficient(match[2])],
            op: operator,
            rhs: Number.parseFloat(match[4]) || 0
        });
    }

    const objectiveAmounts = text.match(/(\d+(?:\.\d+)?)\s*元/g);
    const objCoeffs = objectiveAmounts?.length >= 2
        ? objectiveAmounts.slice(0, 2).map(amount => Number.parseFloat(amount))
        : [20, 15];

    if (constraints.length === 0) {
        constraints.push(
            { name: '資源限制 1', coeffs: [2, 1], op: '<=', rhs: 20 },
            { name: '資源限制 2', coeffs: [1, 3], op: '<=', rhs: 35 }
        );
    }

    const isMin = type === 'min';
    return {
        type,
        unit: isMin ? '元 (成本)' : '元 (利潤)',
        numVars: 2,
        varNames: isMin ? ['原料甲', '原料乙'] : ['產品A', '產品B'],
        varTypes: ['cont', 'cont'],
        objCoeffs,
        constraints
    };
}

export function parseSimpleTwoVariableModel(text) {
    return {
        type: parseObjectiveType(text),
        sourceText: text,
        supported: /x\s*1|x_?1/i.test(text) && /x\s*2|x_?2/i.test(text)
    };
}

</file>

<file path="src\features\analysis\graph-view.js">
import { clipPolygonByHalfPlane } from '../../domain/geometry.js';
import { fmtNum } from '../../ui/formatters.js';
export function draw2DGraph() {
            if (lpState.numVars !== 2) return;
            const canvas = document.getElementById('lp-graph-canvas');
            if (!canvas) return;
            const rect = canvas.parentElement.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;

            const ctx = canvas.getContext('2d');
            ctx.scale(dpr, dpr);
            const W = rect.width;
            const H = rect.height;

            // 清空深色畫布
            ctx.fillStyle = '#080d1a';
            ctx.fillRect(0, 0, W, H);

            // 決定繪圖座標範圍 [0, maxX] x [0, maxY]
            let maxBoundX = 10;
            let maxBoundY = 10;

            lpState.constraints.forEach(c => {
                const a = c.coeffs[0] || 0;
                const b = c.coeffs[1] || 0;
                const rhs = c.rhs;
                if (Math.abs(a) > 1e-5 && rhs / a > 0) maxBoundX = Math.max(maxBoundX, (rhs / a) * 1.25);
                if (Math.abs(b) > 1e-5 && rhs / b > 0) maxBoundY = Math.max(maxBoundY, (rhs / b) * 1.25);
            });

            if (lastSolution && lastSolution.status === 'optimal') {
                maxBoundX = Math.max(maxBoundX, Math.abs(lastSolution.x[0]) * 1.4 + 2);
                maxBoundY = Math.max(maxBoundY, Math.abs(lastSolution.x[1]) * 1.4 + 2);
            }

            // 美化刻度上限
            const niceMax = (v) => {
                const p = Math.pow(10, Math.floor(Math.log10(v)));
                const n = v / p;
                if (n <= 1.5) return 1.5 * p;
                if (n <= 2) return 2 * p;
                if (n <= 3) return 3 * p;
                if (n <= 5) return 5 * p;
                if (n <= 8) return 8 * p;
                return 10 * p;
            };
            const maxX = niceMax(maxBoundX);
            const maxY = niceMax(maxBoundY);

            const padL = 52, padR = 26, padT = 24, padB = 42;
            const plotW = W - padL - padR;
            const plotH = H - padT - padB;

            const toScreenX = (x) => padL + (x / maxX) * plotW;
            const toScreenY = (y) => padT + plotH - (y / maxY) * plotH;
            const toMathX = (px) => ((px - padL) / plotW) * maxX;
            const toMathY = (py) => ((padT + plotH - py) / plotH) * maxY;

            // 綁定滑鼠移動顯示座標
            canvas.onmousemove = (e) => {
                const r = canvas.getBoundingClientRect();
                const mx = toMathX(e.clientX - r.left);
                const my = toMathY(e.clientY - r.top);
                const label = document.getElementById('canvas-hover-coords');
                if (mx >= 0 && mx <= maxX && my >= 0 && my <= maxY) {
                    const zHover = (lpState.objCoeffs[0] || 0) * mx + (lpState.objCoeffs[1] || 0) * my;
                    label.textContent = `游標：(x₁: ${mx.toFixed(2)}, x₂: ${my.toFixed(2)}) | Z = ${zHover.toFixed(2)}`;
                }
            };

            // 1. 繪製背景網格與座標軸刻度
            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 1;
            ctx.fillStyle = '#64748b';
            ctx.font = '11px "JetBrains Mono", monospace';

            const steps = 5;
            for (let i = 0; i <= steps; i++) {
                const vx = (maxX / steps) * i;
                const sx = toScreenX(vx);
                ctx.beginPath();
                ctx.moveTo(sx, padT);
                ctx.lineTo(sx, padT + plotH);
                ctx.stroke();
                ctx.textAlign = 'center';
                ctx.fillText(fmtNum(vx, 1), sx, padT + plotH + 18);

                const vy = (maxY / steps) * i;
                const sy = toScreenY(vy);
                ctx.beginPath();
                ctx.moveTo(padL, sy);
                ctx.lineTo(padL + plotW, sy);
                ctx.stroke();
                ctx.textAlign = 'right';
                ctx.fillText(fmtNum(vy, 1), padL - 8, sy + 4);
            }

            // 軸標籤
            ctx.fillStyle = '#94a3b8';
            ctx.textAlign = 'center';
            ctx.font = 'bold 12px "Inter", sans-serif';
            ctx.fillText(`x₁ (${lpState.varNames[0] || '變數1'})`, padL + plotW / 2, H - 6);
            ctx.save();
            ctx.translate(14, padT + plotH / 2);
            ctx.rotate(-Math.PI / 2);
            ctx.fillText(`x₂ (${lpState.varNames[1] || '變數2'})`, 0, 0);
            ctx.restore();

            // 2. 計算並塗色可行解區域 (Feasible Region Polygon)
            let poly = [
                { x: 0, y: 0 },
                { x: maxX * 2, y: 0 },
                { x: maxX * 2, y: maxY * 2 },
                { x: 0, y: maxY * 2 }
            ];

            // 若有等式限制式，給微小帶寬以視覺化，不等式則直接裁剪半平面
            lpState.constraints.forEach(c => {
                const a = c.coeffs[0] || 0;
                const b = c.coeffs[1] || 0;
                const rhs = c.rhs;
                if (c.op === '<=') {
                    poly = clipPolygonByHalfPlane(poly, a, b, rhs);
                } else if (c.op === '>=') {
                    poly = clipPolygonByHalfPlane(poly, -a, -b, -rhs);
                } else if (c.op === '=') {
                    poly = clipPolygonByHalfPlane(poly, a, b, rhs + 0.05);
                    poly = clipPolygonByHalfPlane(poly, -a, -b, -rhs + 0.05);
                }
            });

            // 裁剪畫布邊界
            const drawPoly = clipPolygonByHalfPlane(
                clipPolygonByHalfPlane(poly, 1, 0, maxX),
                0, 1, maxY
            );

            ctx.save();
            ctx.beginPath();
            ctx.rect(padL, padT, plotW, plotH);
            ctx.clip();

            if (drawPoly.length >= 3) {
                const grad = ctx.createLinearGradient(padL, padT + plotH, padL + plotW, padT);
                grad.addColorStop(0, 'rgba(6, 182, 212, 0.28)');
                grad.addColorStop(1, 'rgba(99, 102, 241, 0.22)');
                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.moveTo(toScreenX(drawPoly[0].x), toScreenY(drawPoly[0].y));
                for (let i = 1; i < drawPoly.length; i++) {
                    ctx.lineTo(toScreenX(drawPoly[i].x), toScreenY(drawPoly[i].y));
                }
                ctx.closePath();
                ctx.fill();

                ctx.strokeStyle = 'rgba(34, 211, 238, 0.7)';
                ctx.lineWidth = 1.8;
                ctx.stroke();
            }

            // 3. 繪製每條限制式邊界直線
            const lineColors = ['#38bdf8', '#a78bfa', '#34d399', '#fbbf24', '#f472b6', '#fb7185'];
            lpState.constraints.forEach((c, idx) => {
                const a = c.coeffs[0] || 0;
                const b = c.coeffs[1] || 0;
                const rhs = c.rhs;
                const color = lineColors[idx % lineColors.length];

                let pts = [];
                if (Math.abs(b) > 1e-7) {
                    pts.push({ x: 0, y: rhs / b });
                    pts.push({ x: maxX, y: (rhs - a * maxX) / b });
                } else if (Math.abs(a) > 1e-7) {
                    pts.push({ x: rhs / a, y: 0 });
                    pts.push({ x: rhs / a, y: maxY });
                }

                if (pts.length === 2) {
                    ctx.strokeStyle = color;
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.moveTo(toScreenX(pts[0].x), toScreenY(pts[0].y));
                    ctx.lineTo(toScreenX(pts[1].x), toScreenY(pts[1].y));
                    ctx.stroke();

                    // 標示限制式名稱
                    const midX = Math.max(0.08 * maxX, Math.min(0.82 * maxX, (pts[0].x + pts[1].x) * 0.4));
                    const midY = Math.abs(b) > 1e-7 ? (rhs - a * midX) / b : maxY * 0.5;
                    if (midY >= 0 && midY <= maxY) {
                        ctx.fillStyle = color;
                        ctx.font = '600 11px "Inter", sans-serif';
                        ctx.textAlign = 'left';
                        ctx.fillText(c.name || `C${idx + 1}`, toScreenX(midX) + 5, toScreenY(midY) - 6);
                    }
                }
            });

            // 4. 繪製等利潤線 / 等成本線 (Iso-profit / Iso-cost Line)
            const showIsoline = document.getElementById('toggle-isoline').checked;
            if (showIsoline && lastSolution && lastSolution.status === 'optimal') {
                const c1 = lpState.objCoeffs[0] || 0;
                const c2 = lpState.objCoeffs[1] || 0;
                const zStar = lastSolution.z;

                let isoPts = [];
                if (Math.abs(c2) > 1e-7) {
                    isoPts.push({ x: 0, y: zStar / c2 });
                    isoPts.push({ x: maxX, y: (zStar - c1 * maxX) / c2 });
                } else if (Math.abs(c1) > 1e-7) {
                    isoPts.push({ x: zStar / c1, y: 0 });
                    isoPts.push({ x: zStar / c1, y: maxY });
                }

                if (isoPts.length === 2) {
                    ctx.strokeStyle = '#fbbf24';
                    ctx.lineWidth = 2.2;
                    ctx.setLineDash([6, 5]);
                    ctx.beginPath();
                    ctx.moveTo(toScreenX(isoPts[0].x), toScreenY(isoPts[0].y));
                    ctx.lineTo(toScreenX(isoPts[1].x), toScreenY(isoPts[1].y));
                    ctx.stroke();
                    ctx.setLineDash([]);
                }
            }

            // 5. 收集所有可行極點 (Corner Points) 並繪製頂點與表格
            let allLines = [
                { a: 1, b: 0, c: 0 }, // x1 = 0
                { a: 0, b: 1, c: 0 }  // x2 = 0
            ];
            lpState.constraints.forEach(c => {
                allLines.push({ a: c.coeffs[0] || 0, b: c.coeffs[1] || 0, c: c.rhs });
            });

            let feasibleVertices = [];
            for (let i = 0; i < allLines.length; i++) {
                for (let j = i + 1; j < allLines.length; j++) {
                    const L1 = allLines[i], L2 = allLines[j];
                    const det = L1.a * L2.b - L2.a * L1.b;
                    if (Math.abs(det) < 1e-9) continue;
                    const x = (L1.c * L2.b - L2.c * L1.b) / det;
                    const y = (L1.a * L2.c - L2.a * L1.c) / det;

                    if (x < -1e-5 || y < -1e-5) continue;

                    // 檢查是否滿足所有限制式
                    let ok = true;
                    for (const con of lpState.constraints) {
                        const val = (con.coeffs[0] || 0) * x + (con.coeffs[1] || 0) * y;
                        if (con.op === '<=' && val > con.rhs + 1e-5) { ok = false; break; }
                        if (con.op === '>=' && val < con.rhs - 1e-5) { ok = false; break; }
                        if (con.op === '=' && Math.abs(val - con.rhs) > 1e-5) { ok = false; break; }
                    }
                    if (!ok) continue;

                    // 去重
                    if (!feasibleVertices.some(v => Math.hypot(v.x - x, v.y - y) < 1e-4)) {
                        const cleanX = Math.abs(x) < 1e-7 ? 0 : x;
                        const cleanY = Math.abs(y) < 1e-7 ? 0 : y;
                        const zVal = (lpState.objCoeffs[0] || 0) * cleanX + (lpState.objCoeffs[1] || 0) * cleanY;
                        feasibleVertices.push({ x: cleanX, y: cleanY, z: zVal });
                    }
                }
            }

            // 繪製端點與更新極點表
            const showVertices = document.getElementById('toggle-vertices').checked;
            const cornerTbody = document.getElementById('corner-points-tbody');
            cornerTbody.innerHTML = '';

            feasibleVertices.forEach((v, idx) => {
                const isOpt = lastSolution && lastSolution.status === 'optimal' &&
                    Math.hypot(v.x - lastSolution.x[0], v.y - lastSolution.x[1]) < 1e-3;

                if (showVertices && !isOpt) {
                    const sx = toScreenX(v.x);
                    const sy = toScreenY(v.y);
                    ctx.fillStyle = '#e2e8f0';
                    ctx.beginPath();
                    ctx.arc(sx, sy, 4.5, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = '#cbd5e1';
                    ctx.font = '11px "JetBrains Mono", monospace';
                    ctx.textAlign = 'left';
                    ctx.fillText(`P${idx + 1}(${fmtNum(v.x, 1)}, ${fmtNum(v.y, 1)})`, sx + 7, sy - 5);
                }

                const tr = document.createElement('tr');
                tr.className = isOpt ? 'bg-cyan-500/20 text-cyan-200 font-bold' : 'text-slate-300';
                tr.innerHTML = `
                    <td class="py-2 px-3">${isOpt ? '★ 最佳端點' : `P${idx + 1}`}</td>
                    <td class="py-2 px-3">(${fmtNum(v.x, 2)}, ${fmtNum(v.y, 2)})</td>
                    <td class="py-2 px-3 text-right">${fmtNum(v.z, 2)}</td>
                `;
                cornerTbody.appendChild(tr);
            });

            if (feasibleVertices.length === 0) {
                cornerTbody.innerHTML = `<tr><td colspan="3" class="py-4 text-center text-slate-500">無可行端點</td></tr>`;
            }

            // 6. 標示最佳解點 (Optimal Solution Point)
            if (lastSolution && lastSolution.status === 'optimal') {
                const ox = lastSolution.x[0];
                const oy = lastSolution.x[1];
                const sx = toScreenX(ox);
                const sy = toScreenY(oy);

                // 外圈光暈
                ctx.fillStyle = 'rgba(244, 63, 94, 0.3)';
                ctx.beginPath();
                ctx.arc(sx, sy, 12, 0, Math.PI * 2);
                ctx.fill();

                // 實心紅點
                ctx.fillStyle = '#f43f5e';
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.arc(sx, sy, 6, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                // 最佳解標籤
                ctx.fillStyle = '#fda4af';
                ctx.font = 'bold 12px "JetBrains Mono", monospace';
                ctx.textAlign = sx > W - 150 ? 'right' : 'left';
                const offsetX = sx > W - 150 ? -12 : 12;
                ctx.fillText(`Optimal (${fmtNum(ox, 2)}, ${fmtNum(oy, 2)}) Z*=${fmtNum(lastSolution.z, 1)}`, sx + offsetX, sy - 10);
            }

            ctx.restore();
        }

        /*************************************************************************
         * 經典案例快速載入 (Presets)
         *************************************************************************/

if (typeof window !== 'undefined') {
    Object.assign(window, { draw2DGraph });
}

</file>

<file path="src\features\analysis\results-view.js">
import { fmtNum, subDigit, formatLinearExpression } from '../../ui/formatters.js';
import { escapeHtml } from '../../ui/dom.js';
export function solveCurrentLP() {
            const sol = solveFullLPModel(lpState);
            lastSolution = sol;

            const statusBadge = document.getElementById('solution-status-badge');
            const errorBox = document.getElementById('solution-error-box');
            const contentWrapper = document.getElementById('solution-content-wrapper');

            if (sol.truncated || sol.status === 'limit') {
                statusBadge.innerHTML = `
                    <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 flex items-center gap-2">
                        <i class="fa-solid fa-hourglass-half"></i> 整數搜尋達到節點上限
                    </span>
                `;
                errorBox.className = 'rounded-2xl p-6 bg-amber-950/40 border border-amber-500/40 text-amber-200 space-y-2';
                errorBox.textContent = '分支界限搜尋已達 250 個節點上限，尚未證明目前最佳整數解為全域最佳解。請簡化模型後重試。';
                contentWrapper.classList.add('hidden');
                showToast('整數搜尋已達節點上限；結果尚未證明為最佳解。', 'warn');
                return;
            }

            if (sol.status === 'infeasible') {
                statusBadge.innerHTML = `
                    <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40 flex items-center gap-2">
                        <i class="fa-solid fa-circle-exclamation"></i> 無可行解 (Infeasible Solution)
                    </span>
                `;
                errorBox.className = 'rounded-2xl p-6 bg-rose-950/40 border border-rose-500/40 text-rose-200 space-y-2';
                errorBox.innerHTML = `
                    <div class="text-base font-bold flex items-center gap-2 text-rose-300">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span>系統偵測結果：此線性規劃問題「無可行解 (Infeasible)」</span>
                    </div>
                    <p class="text-sm text-rose-200/90 leading-relaxed">
                        <strong>原因分析：</strong>您設定的限制條件彼此衝突（例如同時要求資源使用量小於 10 又必須大於 20），導致沒有任何一組決策變數 <span class="font-mono">(x₁, x₂, ...)</span> 能同時滿足所有限制式（可行解區域為空集合 ∅）。
                    </p>
                    <p class="text-xs text-rose-300/80 pt-1">
                        建議調整：請放寬 <span class="font-mono">≥</span> 最低需求限制，或增加 <span class="font-mono">≤</span> 資源上限常數 (RHS)。
                    </p>
                `;
                contentWrapper.classList.add('hidden');
                if (lpState.numVars === 2) {
                    contentWrapper.classList.remove('hidden');
                    document.getElementById('graphical-analysis-card').classList.remove('hidden');
                    draw2DGraph();
                }
                showToast('問題無可行解 (Infeasible)，請檢查限制條件衝突。', 'error');
                return;
            }

            if (sol.status === 'unbounded') {
                statusBadge.innerHTML = `
                    <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 flex items-center gap-2">
                        <i class="fa-solid fa-infinity"></i> 無界解 (Unbounded Solution)
                    </span>
                `;
                errorBox.className = 'rounded-2xl p-6 bg-amber-950/40 border border-amber-500/40 text-amber-200 space-y-2';
                errorBox.innerHTML = `
                    <div class="text-base font-bold flex items-center gap-2 text-amber-300">
                        <i class="fa-solid fa-infinity"></i>
                        <span>系統偵測結果：此線性規劃問題為「無界解 (Unbounded)」</span>
                    </div>
                    <p class="text-sm text-amber-200/90 leading-relaxed">
                        <strong>原因分析：</strong>可行解區域向無限遠處延伸，且目標函數值 <span class="font-mono">Z</span> 可以無限制地${lpState.type === 'max' ? '增大至 +∞' : '減小至 -∞'}，而不會違反任何一條限制式。
                    </p>
                    <p class="text-xs text-amber-300/80 pt-1">
                        建議調整：在實際管理問題中，通常代表遺漏了關鍵的資源上限限制式 (<span class="font-mono">≤</span>)。
                    </p>
                `;
                contentWrapper.classList.add('hidden');
                if (lpState.numVars === 2) {
                    contentWrapper.classList.remove('hidden');
                    document.getElementById('graphical-analysis-card').classList.remove('hidden');
                    draw2DGraph();
                }
                showToast('問題為無界解 (Unbounded)，目標函數可無限延伸。', 'warn');
                return;
            }

            // 最佳解呈現
            errorBox.className = 'hidden';
            contentWrapper.classList.remove('hidden');

            statusBadge.innerHTML = `
                <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 flex items-center gap-2">
                    <i class="fa-solid fa-circle-check"></i> 已求得最佳解 (Optimal Solution Found)
                </span>
            `;

            // 1. 最佳目標函數值 Z*
            document.getElementById('res-obj-type-label').textContent = lpState.type === 'max'
                ? '最大目標函數值 (Max Z*)'
                : '最小目標函數值 (Min Z*)';
            document.getElementById('res-z-value').textContent = fmtNum(sol.z);
            document.getElementById('res-z-unit').textContent = `目標單位：${lpState.unit || '單位'}`;
            document.getElementById('res-iter-info').textContent = sol.isIntegerOptimal
                ? `分支界限與單形迭代：${sol.iterations} 次 (整數最佳解)`
                : `兩階段單形法迭代：${sol.iterations} 次`;

            // 2. 各決策變數最佳值卡片
            const varsGrid = document.getElementById('res-vars-grid');
            varsGrid.innerHTML = '';
            for (let i = 0; i < lpState.numVars; i++) {
                const sub = subDigit(i + 1);
                const val = sol.x[i];
                const contrib = (lpState.objCoeffs[i] || 0) * val;
                const vName = lpState.varNames[i] || `變數 x${sub}`;
                const card = document.createElement('div');
                card.className = 'p-3.5 rounded-xl bg-slate-950/90 border border-slate-800 hover:border-cyan-500/40 transition flex flex-col justify-between';
                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-slate-400 truncate" title="${vName}">${vName}</span>
                        <span class="font-mono text-xs font-bold text-cyan-400 bg-cyan-500/10 px-1.5 py-0.5 rounded">x${sub}*</span>
                    </div>
                    <div class="my-2 text-2xl font-extrabold font-mono text-white">${fmtNum(val)}</div>
                    <div class="text-[11px] text-slate-500 font-mono">
                        目標貢獻: ${contrib >= 0 ? '+' : ''}${fmtNum(contrib)}
                    </div>
                `;
                varsGrid.appendChild(card);
            }

            // 3. 功能需求 8：求解結果管理意涵解讀
            const summaryBox = document.getElementById('res-management-summary');
            const actionLines = [];
            for (let i = 0; i < lpState.numVars; i++) {
                const sub = subDigit(i + 1);
                const vName = lpState.varNames[i] || `決策變數 x${sub}`;
                const val = sol.x[i];
                actionLines.push(`<li><strong>${vName} (<span class="font-mono text-cyan-300">x${sub}*</span>)</strong>：建議投入 / 生產 <span class="font-mono font-bold text-white px-1.5 py-0.5 rounded bg-slate-800">${fmtNum(val)}</span> 單位（目標貢獻值：<span class="font-mono text-cyan-300">${fmtNum((lpState.objCoeffs[i] || 0) * val)}</span>）</li>`);
            }
            const goalText = lpState.type === 'max' ? '最大總目標值（如最大利潤/效益）' : '最小總目標值（如最低成本/耗損）';
            summaryBox.innerHTML = `
                <div class="font-semibold text-indigo-300 mb-1">【最佳管理決策方案】</div>
                <ul class="list-disc list-inside space-y-1 text-slate-200">
                    ${actionLines.join('')}
                </ul>
                <div class="pt-2 mt-2 border-t border-slate-800/80 text-emerald-300 font-medium">
                    <i class="fa-solid fa-check-double mr-1.5"></i>依此方案執行，可在滿足所有資源與規範限制下，達成${goalText} <strong class="font-mono text-base text-white">Z* = ${fmtNum(sol.z)}</strong>（${lpState.unit}）。
                </div>
            `;

            // 4. 功能需求 9 & 10：限制式分析與敏感度分析表格
            const tbody = document.getElementById('res-constraints-tbody');
            tbody.innerHTML = '';
            const notesList = document.getElementById('res-sensitivity-notes');
            notesList.innerHTML = '';

            sol.constraints.forEach((c, idx) => {
                const mathStr = `${formatLinearExpression(c.coeffs, lpState.numVars)} ${c.op === '<=' ? '≤' : (c.op === '>=' ? '≥' : '=')} ${fmtNum(c.rhs)}`;
                const opSym = c.op === '<=' ? '≤' : (c.op === '>=' ? '≥' : '=');
                const slackLabel = c.op === '<=' ? 'Slack (鬆弛)' : (c.op === '>=' ? 'Surplus (剩餘)' : '差額');

                const statusBadgeHtml = c.isBinding
                    ? `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-sans font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                         <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Binding (緊束/等號成立)
                       </span>`
                    : `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-sans font-medium bg-slate-800 text-slate-400 border border-slate-700">
                         Nonbinding (${slackLabel} ${fmtNum(c.slack)})
                       </span>`;

                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-900/50 transition';
                tr.innerHTML = `
                    <td class="py-3 px-4">
                        <div class="font-sans font-semibold text-slate-200">${escapeHtml(c.name)}</div>
                        <div class="text-xs text-slate-500">${mathStr}</div>
                    </td>
                    <td class="py-3 px-4 text-right font-bold text-white">${fmtNum(c.lhs)}</td>
                    <td class="py-3 px-4 text-center text-amber-400 font-bold">${opSym}</td>
                    <td class="py-3 px-4 text-right text-slate-300">${fmtNum(c.rhs)}</td>
                    <td class="py-3 px-4 text-right ${c.slack > 1e-5 ? 'text-amber-300' : 'text-slate-500'}">
                        ${fmtNum(c.slack)} <span class="text-[10px] font-sans text-slate-500">(${slackLabel})</span>
                    </td>
                    <td class="py-3 px-4 text-right font-bold ${Math.abs(c.shadowPrice) > 1e-5 ? 'text-cyan-400' : 'text-slate-500'}">
                        ${sol.isIntegerOptimal ? '<span class="text-xs font-sans text-slate-500">N/A (整數規劃)</span>' : fmtNum(c.shadowPrice)}
                    </td>
                    <td class="py-3 px-4 text-center">${statusBadgeHtml}</td>
                `;
                tbody.appendChild(tr);

                // 自動生成每條限制式的敏感度管理意涵
                const li = document.createElement('li');
                if (c.isBinding) {
                    if (!sol.isIntegerOptimal && Math.abs(c.shadowPrice) > 1e-6) {
                        const dirText = c.shadowPrice > 0 ? `增加 ${fmtNum(c.shadowPrice)}` : `改變 ${fmtNum(c.shadowPrice)}`;
                        li.innerHTML = `<strong class="text-emerald-300">【${escapeHtml(c.name)}】</strong>為<strong>瓶頸資源 (Binding Constraint)</strong>，資源已全數用罄（Slack = 0）。其影子價格 (Shadow Price) 為 <span class="font-mono text-cyan-300 font-bold">${fmtNum(c.shadowPrice)}</span>，代表在現行最佳基底不變範圍內，每增加 1 單位【${escapeHtml(c.name)}】右端上限，最佳目標函數值 Z* 可${dirText} 單位。`;
                    } else {
                        li.innerHTML = `<strong class="text-emerald-300">【${escapeHtml(c.name)}】</strong>為<strong>緊束限制 (Binding Constraint)</strong>，在最佳解下等號完全成立（LHS = RHS = ${fmtNum(c.rhs)}）。`;
                    }
                } else {
                    const remainType = c.op === '<=' ? `尚有未用完之餘裕（鬆弛量 Slack = ${fmtNum(c.slack)} 單位）` : `超出最低要求標準（剩餘量 Surplus = ${fmtNum(c.slack)} 單位）`;
                    li.innerHTML = `<strong class="text-slate-300">【${escapeHtml(c.name)}】</strong>為<strong>非緊束限制 (Nonbinding Constraint)</strong>，${remainType}。其影子價格為 <span class="font-mono">0</span>，單獨增加此資源上限並不會改善目標函數值。`;
                }
                notesList.appendChild(li);
            });

            // 5. 功能需求 11(a)：當決策變數個數為 2 時，自動顯示並繪製 2D 圖形化分析
            const graphCard = document.getElementById('graphical-analysis-card');
            if (lpState.numVars === 2) {
                graphCard.classList.remove('hidden');
                setTimeout(() => draw2DGraph(), 30);
            } else {
                graphCard.classList.add('hidden');
            }
        }

        /*************************************************************************
         * 功能需求 11(a)：雙變數 2D 圖形化分析引擎 (HTML5 Canvas)
         * - 使用 Sutherland-Hodgman 多邊形裁剪演算法精確繪製可行域 (Feasible Region)
         * - 自動計算所有交點與可行端點 (Corner Points)
         * - 繪製各限制式直線、等利潤/等成本線 (Iso-profit / Iso-cost Line) 與最佳解位置
         *************************************************************************/

if (typeof window !== 'undefined') {
    Object.assign(window, { solveCurrentLP });
}

</file>

<file path="src\features\general-lp\general-lp-controller.js">
export function setProblemType(type) {
            lpState.type = type;
            const btnMax = document.getElementById('btn-type-max');
            const btnMin = document.getElementById('btn-type-min');
            const badge = document.getElementById('obj-prefix-badge');

            if (type === 'max') {
                btnMax.className = 'py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-1.5 bg-cyan-600 text-white shadow';
                btnMin.className = 'py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-1.5 text-slate-400 hover:text-white';
                badge.textContent = 'max Z =';
                badge.className = 'px-2.5 py-1 rounded-lg bg-cyan-500/20 text-cyan-300 font-mono font-bold text-sm border border-cyan-500/30';
            } else {
                btnMin.className = 'py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-1.5 bg-indigo-600 text-white shadow';
                btnMax.className = 'py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition flex items-center justify-center gap-1.5 text-slate-400 hover:text-white';
                badge.textContent = 'min Z =';
                badge.className = 'px-2.5 py-1 rounded-lg bg-indigo-500/20 text-indigo-300 font-mono font-bold text-sm border border-indigo-500/30';
            }
            renderLiveMathModel();
        }

export function changeVarCount(delta) {
            const next = Math.max(1, Math.min(16, lpState.numVars + delta));
            setVarCount(next);
        }

export function setVarCount(val) {
            let n = parseInt(val, 10);
            if (isNaN(n) || n < 1) n = 1;
            if (n > 16) n = 16;

            lpState.numVars = n;
            document.getElementById('input-var-count').value = n;

            // 擴充或裁切陣列
            while (lpState.varNames.length < n) {
                const idx = lpState.varNames.length + 1;
                lpState.varNames.push(`產品${String.fromCharCode(64 + idx)}`);
            }
            while (lpState.varTypes.length < n) {
                lpState.varTypes.push('cont');
            }
            while (lpState.objCoeffs.length < n) {
                lpState.objCoeffs.push(0);
            }

            lpState.constraints.forEach(c => {
                while (c.coeffs.length < n) c.coeffs.push(0);
            });

            renderAllGeneralLPInputs();
        }

export function addConstraint() {
            const idx = lpState.constraints.length + 1;
            lpState.constraints.push({
                name: `限制條件 ${idx}`,
                coeffs: new Array(lpState.numVars).fill(1),
                op: '<=',
                rhs: 10
            });
            renderConstraintsList();
            renderLiveMathModel();
        }

export function removeConstraint(idx) {
            if (lpState.constraints.length <= 1) {
                showToast('系統至少需保留一條限制式', 'warn');
                return;
            }
            lpState.constraints.splice(idx, 1);
            renderConstraintsList();
            renderLiveMathModel();
        }

export function updateModelState() {
            lpState.unit = document.getElementById('obj-unit-input').value;
            renderLiveMathModel();
        }

        /*************************************************************************
         * 功能需求 6：即時顯示完整線性規劃數學模型
         *************************************************************************/

export function copyMathModel() {
            const box = document.getElementById('live-math-display');
            const text = box.innerText;
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            textarea.remove();
            showToast('數學模型已複製到剪貼簿！', 'success');
        }

        /*************************************************************************
         * 核心數學引擎：兩階段單形法 (Two-Phase Simplex) + 分支界限法 (Branch & Bound)
         * 100% 純前端實作，精確計算：
         * - 最佳解 x* 與目標函數 Z*
         * - 無可行解 (Infeasible) 與無界解 (Unbounded) 判定
         * - 各限制式之左側值 (LHS)、鬆弛/剩餘量 (Slack/Surplus)、緊束狀態 (Binding)
         * - 各限制式之對偶影子價格 (Shadow Price)
         *************************************************************************/

export function loadPreset(presetKey) {
    const preset = presets[presetKey];
    if (!preset) {
        showToast(`找不到預設題目：${presetKey}`, 'error');
        return;
    }

    lpState = JSON.parse(JSON.stringify(preset.model));
    showToast(preset.message, preset.type);
    renderAllGeneralLPInputs();
    solveCurrentLP();
}

export function resetLPForm() {
            lpState = {
                type: 'max',
                unit: '元',
                numVars: 2,
                varNames: ['產品1', '產品2'],
                varTypes: ['cont', 'cont'],
                objCoeffs: [1, 1],
                constraints: [
                    { name: '限制式 1', coeffs: [1, 1], op: '<=', rhs: 10 }
                ]
            };
            renderAllGeneralLPInputs();
            solveCurrentLP();
            showToast('表單已重設為空白初始狀態', 'info');
        }

        /*************************************************************************
         * 進階功能 1：運輸問題範本 (Transportation Problem Step 1 ~ Step 8)
         *************************************************************************/

if (typeof window !== 'undefined') {
    Object.assign(window, { setProblemType, changeVarCount, setVarCount, addConstraint, removeConstraint, updateModelState, copyMathModel, loadPreset, resetLPForm });
}
import { presets } from '../../data/presets.js';

</file>

<file path="src\features\general-lp\general-lp-view.js">
import { fmtNum, subDigit, formatLinearExpression } from '../../ui/formatters.js';
import { escapeHtml } from '../../ui/dom.js';
export function renderAllGeneralLPInputs() {
            setProblemType(lpState.type);
            document.getElementById('input-var-count').value = lpState.numVars;
            document.getElementById('obj-unit-input').value = lpState.unit;

            // 1. 渲染決策變數設定區
            const varContainer = document.getElementById('var-settings-container');
            varContainer.innerHTML = '';
            for (let i = 0; i < lpState.numVars; i++) {
                const sub = subDigit(i + 1);
                const div = document.createElement('div');
                div.className = 'flex items-center gap-2 bg-slate-950/90 p-2 rounded-xl border border-slate-800';
                div.innerHTML = `
                    <span class="px-2 py-1 rounded-lg bg-slate-900 text-cyan-400 font-mono font-bold text-xs border border-slate-800">x${sub}</span>
                    <input type="text" value="${lpState.varNames[i] || ''}" placeholder="變數名稱"
                        oninput="lpState.varNames[${i}] = this.value; renderLiveMathModel();"
                        class="w-full min-w-0 bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-xs text-slate-200 focus:outline-none focus:border-cyan-500">
                    <select onchange="lpState.varTypes[${i}] = this.value; renderLiveMathModel();"
                        class="bg-slate-900 border border-slate-800 rounded-lg px-2 py-1 text-xs text-slate-300 font-mono focus:outline-none focus:border-cyan-500">
                        <option value="cont" ${lpState.varTypes[i] === 'cont' ? 'selected' : ''}>x${sub} ≥ 0 (非負)</option>
                        <option value="free" ${lpState.varTypes[i] === 'free' ? 'selected' : ''}>x${sub} Free (取消非負)</option>
                        <option value="int" ${lpState.varTypes[i] === 'int' ? 'selected' : ''}>x${sub} ∈ ℤ⁺ (整數)</option>
                        <option value="bin" ${lpState.varTypes[i] === 'bin' ? 'selected' : ''}>x${sub} ∈ {0,1} (二元)</option>
                    </select>
                `;
                varContainer.appendChild(div);
            }

            // 2. 渲染目標函數係數輸入
            const objContainer = document.getElementById('obj-coeffs-container');
            objContainer.innerHTML = '';
            for (let i = 0; i < lpState.numVars; i++) {
                const sub = subDigit(i + 1);
                const item = document.createElement('div');
                item.className = 'flex items-center gap-1.5';
                item.innerHTML = `
                    ${i > 0 ? '<span class="text-slate-500 font-mono font-bold">+</span>' : ''}
                    <input type="number" step="any" value="${lpState.objCoeffs[i]}"
                        oninput="lpState.objCoeffs[${i}] = parseFloat(this.value) || 0; renderLiveMathModel();"
                        class="w-20 px-2 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-right font-mono text-sm text-white focus:outline-none focus:border-cyan-500">
                    <span class="font-mono text-sm text-cyan-300 font-semibold">x${sub}</span>
                `;
                objContainer.appendChild(item);
            }

            // 3. 渲染限制式列表
            renderConstraintsList();

            // 4. 渲染即時數學式
            renderLiveMathModel();
        }

export function renderConstraintsList() {
            const container = document.getElementById('constraints-container');
            container.innerHTML = '';

            lpState.constraints.forEach((c, cIdx) => {
                const row = document.createElement('div');
                row.className = 'bg-slate-950/90 p-3.5 rounded-xl border border-slate-800/90 space-y-2.5 transition hover:border-slate-700';

                let coeffsHtml = '';
                for (let i = 0; i < lpState.numVars; i++) {
                    const sub = subDigit(i + 1);
                    coeffsHtml += `
                        <div class="flex items-center gap-1">
                            ${i > 0 ? '<span class="text-slate-500 font-mono text-xs">+</span>' : ''}
                            <input type="number" step="any" value="${c.coeffs[i] ?? 0}"
                                oninput="lpState.constraints[${cIdx}].coeffs[${i}] = parseFloat(this.value) || 0; renderLiveMathModel();"
                                class="w-16 sm:w-20 px-2 py-1 bg-slate-900 border border-slate-700 rounded-lg text-right font-mono text-xs sm:text-sm text-white focus:outline-none focus:border-cyan-500">
                            <span class="font-mono text-xs sm:text-sm text-slate-300">x${sub}</span>
                        </div>
                    `;
                }

                row.innerHTML = `
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-900 text-slate-400 border border-slate-800">C${cIdx + 1}</span>
                            <input type="text" value="${escapeHtml(c.name || '')}" placeholder="限制式名稱 (例如：預算限制)"
                                oninput="lpState.constraints[${cIdx}].name = this.value; renderLiveMathModel();"
                                class="w-44 sm:w-56 bg-transparent border-b border-slate-800 focus:border-cyan-500 text-xs text-slate-200 py-0.5 focus:outline-none">
                        </div>
                        <button type="button" onclick="removeConstraint(${cIdx})" class="text-slate-500 hover:text-rose-400 text-xs px-2 py-1 rounded transition" title="刪除此限制式">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 pt-1">
                        <div class="flex flex-wrap items-center gap-1.5 flex-1">
                            ${coeffsHtml}
                        </div>
                        <div class="flex items-center gap-2">
                            <select onchange="lpState.constraints[${cIdx}].op = this.value; renderLiveMathModel();"
                                class="bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1 font-mono text-sm font-bold text-amber-400 focus:outline-none focus:border-cyan-500">
                                <option value="<=" ${c.op === '<=' ? 'selected' : ''}>≤</option>
                                <option value="=" ${c.op === '=' ? 'selected' : ''}>=</option>
                                <option value=">=" ${c.op === '>=' ? 'selected' : ''}>≥</option>
                            </select>
                            <input type="number" step="any" value="${c.rhs}"
                                oninput="lpState.constraints[${cIdx}].rhs = parseFloat(this.value) || 0; renderLiveMathModel();"
                                class="w-20 sm:w-24 px-2.5 py-1 bg-slate-900 border border-slate-700 rounded-lg text-right font-mono text-sm font-semibold text-emerald-300 focus:outline-none focus:border-cyan-500">
                        </div>
                    </div>
                `;
                container.appendChild(row);
            });
        }

export function renderLiveMathModel() {
            const box = document.getElementById('live-math-display');
            const n = lpState.numVars;
            const objExpr = formatLinearExpression(lpState.objCoeffs, n);
            const typeStr = lpState.type === 'max' ? 'max' : 'min';

            let stHtml = '';
            lpState.constraints.forEach((c, idx) => {
                const expr = formatLinearExpression(c.coeffs, n);
                const opSym = c.op === '<=' ? '≤' : (c.op === '>=' ? '≥' : '=');
                const label = c.name ? `<span class="text-slate-500 text-xs ml-3">// ${escapeHtml(c.name)}</span>` : '';
                stHtml += `<div class="pl-4 text-slate-200">${expr} <span class="text-amber-400 font-bold">${opSym}</span> <span class="text-emerald-300">${fmtNum(c.rhs)}</span>${label}</div>`;
            });

            // 整理定義域條件
            let nonNegVars = [];
            let freeVars = [];
            let intVars = [];
            let binVars = [];
            for (let i = 0; i < n; i++) {
                const v = `x${subDigit(i + 1)}`;
                const t = lpState.varTypes[i] || 'cont';
                if (t === 'cont') nonNegVars.push(v);
                else if (t === 'free') freeVars.push(v);
                else if (t === 'int') { nonNegVars.push(v); intVars.push(v); }
                else if (t === 'bin') binVars.push(v);
            }

            let domainLines = [];
            if (nonNegVars.length > 0) domainLines.push(`${nonNegVars.join(', ')} ≥ 0`);
            if (freeVars.length > 0) domainLines.push(`${freeVars.join(', ')} Free (無非負限制)`);
            if (intVars.length > 0) domainLines.push(`${intVars.join(', ')} ∈ ℤ⁺ (整數)`);
            if (binVars.length > 0) domainLines.push(`${binVars.join(', ')} ∈ {0, 1} (二元)`);

            box.innerHTML = `
                <div class="text-cyan-300 font-bold text-base">
                    <span class="uppercase text-xs px-1.5 py-0.5 rounded bg-cyan-500/20 mr-1">${typeStr}</span> Z = ${objExpr}
                </div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider pt-1">subject to (受限於)</div>
                <div class="space-y-1.5 border-l-2 border-slate-800 ml-1">
                    ${stHtml}
                </div>
                <div class="pt-2 border-t border-slate-800/80 text-xs text-indigo-300 space-y-1">
                    ${domainLines.map(line => `<div>${line}</div>`).join('')}
                </div>
            `;
        }

if (typeof window !== 'undefined') {
    Object.assign(window, { renderAllGeneralLPInputs, renderConstraintsList, renderLiveMathModel });
}

</file>

<file path="src\features\onboarding\model-metadata.js">
import { guidedScenarioData } from '../../data/guided-scenarios.js';

export function getModelDisplayName(scenarioKey) {
    return guidedScenarioData[scenarioKey]?.displayName || '線性規劃模型（LP）';
}

window.getModelDisplayName = getModelDisplayName;

