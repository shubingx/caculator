<file path="tests\domain\lp-solver.test.js">
import test from 'node:test';
import assert from 'node:assert/strict';
import { createLpModel } from '../../src/domain/lp-model.js';
import { solveFullLPModel } from '../../src/domain/integer-solver.js';

function model(type, objCoeffs, constraints, varTypes = ['cont', 'cont']) {
    return createLpModel({
        type,
        numVars: objCoeffs.length,
        varNames: objCoeffs.map((_, index) => `x${index + 1}`),
        varTypes,
        objCoeffs,
        constraints
    });
}

test('solves the lecture example and returns shadow prices', () => {
    const solution = solveFullLPModel(model('max', [20, 15], [
        { name: 'raw material', coeffs: [2, 1], op: '<=', rhs: 20 },
        { name: 'labor', coeffs: [1, 3], op: '<=', rhs: 35 }
    ]));

    assert.equal(solution.status, 'optimal');
    assert.deepEqual(solution.x, [5, 10]);
    assert.equal(solution.z, 250);
    assert.deepEqual(solution.constraints.map(constraint => constraint.shadowPrice), [9, 2]);
});

test('reports infeasible and unbounded models', () => {
    const infeasible = solveFullLPModel(model('max', [10, 15], [
        { coeffs: [1, 1], op: '<=', rhs: 10 },
        { coeffs: [1, 1], op: '>=', rhs: 20 }
    ]));
    const unbounded = solveFullLPModel(model('max', [10, 20], [
        { coeffs: [1, 1], op: '>=', rhs: 5 },
        { coeffs: [-1, 1], op: '<=', rhs: 10 }
    ]));

    assert.equal(infeasible.status, 'infeasible');
    assert.equal(unbounded.status, 'unbounded');
});

test('solves an integer model and marks node-limit results as truncated', () => {
    const integerSolution = solveFullLPModel(model('max', [8, 5], [
        { coeffs: [1, 1], op: '<=', rhs: 6 },
        { coeffs: [9, 5], op: '<=', rhs: 45 }
    ], ['int', 'int']));
    const limitedSolution = solveFullLPModel(model('max', [1], [
        { coeffs: [1], op: '<=', rhs: 2.5 }
    ], ['int']), 1);

    assert.equal(integerSolution.status, 'optimal');
    assert.equal(integerSolution.z, 40);
    assert.ok(integerSolution.x.every(Number.isInteger));
    assert.equal(limitedSolution.status, 'limit');
    assert.equal(limitedSolution.truncated, true);
});

</file>

<file path="tests\domain\transport-model.test.js">
import test from 'node:test';
import assert from 'node:assert/strict';
import { createTransportModel, isBalancedTransport } from '../../src/domain/transport-model.js';

const state = {
    numSources: 1,
    numDests: 2,
    sourceNames: ['S1'],
    destNames: ['A', 'B'],
    supplies: [10],
    demands: [4, 6],
    costs: [[2, 3]]
};

test('builds a balanced transport LP', () => {
    const model = createTransportModel(state);
    assert.equal(model.numVars, 2);
    assert.equal(model.constraints.length, 3);
    assert.equal(model.constraints[0].op, '<=');
    assert.equal(model.constraints[0].rhs, 10);
    assert.equal(model.constraints[1].op, '=');
    assert.equal(model.constraints[1].rhs, 4);
    assert.equal(isBalancedTransport(state), true);
});

test('treats floating-point totals within tolerance as balanced', () => {
    assert.equal(isBalancedTransport({ supplies: [0.1, 0.2], demands: [0.3] }), true);
});

test('reports surplus supply as unbalanced without changing demand constraints', () => {
    const surplusState = { ...state, supplies: [11] };
    const model = createTransportModel(surplusState);

    assert.equal(isBalancedTransport(surplusState), false);
    assert.equal(model.constraints[0].op, '<=');
    assert.equal(model.constraints[1].op, '=');
});

</file>

<file path="tests\features\catalog.test.js">
import test from 'node:test';
import assert from 'node:assert/strict';
import { guidedScenarioData } from '../../src/data/guided-scenarios.js';
import { presets } from '../../src/data/presets.js';
import { templates } from '../../src/data/templates.js';
import { transportPresets } from '../../src/data/transport-presets.js';
import { solveFullLPModel } from '../../src/domain/integer-solver.js';
import { createTransportModel } from '../../src/domain/transport-model.js';

test('all LP presets and templates load into solvable models', () => {
    for (const [key, preset] of Object.entries(presets)) {
        const solution = solveFullLPModel(preset.model);
        const expectedStatus = key === 'infeasible' ? 'infeasible' : key === 'unbounded' ? 'unbounded' : 'optimal';
        assert.equal(solution.status, expectedStatus, `preset ${key}`);
    }

    for (const [key, template] of Object.entries(templates)) {
        assert.equal(solveFullLPModel(template.model).status, 'optimal', `template ${key}`);
    }
});

test('both transport examples solve and all five guided model categories are defined', () => {
    for (const [key, preset] of Object.entries(transportPresets)) {
        const model = createTransportModel(preset.state);
        assert.equal(solveFullLPModel(model).status, 'optimal', `transport preset ${key}`);
    }

    const guidedKeys = ['allocation', 'cost', 'transport', 'assignment', 'blending'];
    for (const key of guidedKeys) {
        assert.ok(guidedScenarioData[key], `guided scenario ${key}`);
        assert.ok(guidedScenarioData[key].model, `guided scenario model ${key}`);
    }
});

</file>

<file path="tests\features\parser.test.js">
import test from 'node:test';
import assert from 'node:assert/strict';
import { parseNaturalLanguageToModel } from '../../src/features/ai-parser/parser.js';

test('parses objective coefficients and unicode inequalities', () => {
    const model = parseNaturalLanguageToModel(
        '最小化採購成本：原料甲成本 5 元，原料乙成本 8 元。2x1 + 3x2 ≥ 18，x1 + x2 <= 7。'
    );

    assert.equal(model.type, 'min');
    assert.deepEqual(model.objCoeffs, [5, 8]);
    assert.deepEqual(model.constraints.map(constraint => constraint.op), ['>=', '<=']);
    assert.deepEqual(model.constraints.map(constraint => constraint.coeffs), [[2, 3], [1, 1]]);
});

test('retains the established example model when no constraints are recognized', () => {
    const model = parseNaturalLanguageToModel('最大化收益，產品A 20 元，產品B 15 元。');

    assert.equal(model.type, 'max');
    assert.deepEqual(model.objCoeffs, [20, 15]);
    assert.equal(model.constraints.length, 2);
});

</file>

